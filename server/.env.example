# Copy to server/.env (gitignored). Never commit real values.
# Pip loads the first of: $LITTLE_EXPLORER_ENV (a path), server/.env, ~/.config/little-explorer/.env
# (a per-user copy that survives deleting this checkout; keep it chmod 600).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
OPENAI_API_KEY=

# Optional overrides
# PIP_MODE=pipeline          # or 'realtime' (OpenAI speech-to-speech); restart the agent after changing
# PIP_REALTIME_MODEL=gpt-realtime   # realtime mode only; gpt-realtime-mini is cheaper
# PIP_USAGE_FILE=~/.config/little-explorer/usage.csv   # per-session cost log (see README)
# PIP_PRICE_GPT_REALTIME_AUDIO_OUT=64   # override a list price, USD per 1M tokens
# PIP_REALTIME_EAGERNESS=low        # realtime turn-taking: low waits longest for slow readers
# PIP_OPENAI_STT_MODEL=gpt-realtime-whisper   # pipeline mode streaming transcription
# PIP_SPEECH=openai          # or 'livekit' for LiveKit Inference STT/TTS + turn detector
# PIP_OPENAI_VOICE=coral
# PIP_LLM_MODEL=openai:gpt-5.4-mini
# PIP_GATE_MODEL=openai:gpt-5.4-nano
# PIP_TTS_VOICE=
# TOKEN_SERVER_HOST=127.0.0.1
# TOKEN_SERVER_PORT=8787
# CONTENT_DIR=../LittleExplorer/Resources/Books
