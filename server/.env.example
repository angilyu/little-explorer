# Copy to server/.env (gitignored). Never commit real values.
# Milo loads the first of: $LITTLE_EXPLORER_ENV (a path), server/.env, ~/.config/little-explorer/.env
# (a per-user copy that survives deleting this checkout; keep it chmod 600).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
OPENAI_API_KEY=

# Optional overrides
# PIP_MODE=pipeline          # or 'realtime' (OpenAI speech-to-speech); restart the agent after changing
# PIP_REALTIME_MODEL=gpt-realtime   # realtime mode only; gpt-realtime-mini is cheaper
# PIP_USAGE_FILE=~/.config/little-explorer/usage.csv   # per-session cost log (see README)
# PIP_PRICE_GPT_REALTIME_AUDIO_OUT=64   # override a list price, USD per 1M tokens
# PIP_REALTIME_EAGERNESS=low        # realtime turn-taking: low waits longest for slow readers
# PIP_OPENAI_STT_MODEL=gpt-realtime-whisper   # pipeline mode streaming transcription
# PIP_SPEECH=openai          # or 'livekit' for LiveKit Inference STT/TTS + turn detector
# PIP_OPENAI_VOICE=coral
# PIP_LLM_MODEL=openai:gpt-5.4-mini
# PIP_GATE_MODEL=openai:gpt-5.4-nano
# PIP_TTS_VOICE=
# TOKEN_SERVER_HOST=127.0.0.1
# TOKEN_SERVER_PORT=8787
# CONTENT_DIR=../LittleExplorer/Resources/Books

# Token + content server
# PIP_ACCESS_KEY=            # if set, /token needs "Authorization: Bearer <key>" (set it on any public host;
#                            # the app gets the same key from LittleExplorer/Config/Local.xcconfig)
# CONTENT_ROOT=../LittleExplorer/Resources   # what /content serves (library.json, Books, Photos, Narration)
# KEEPALIVE_SECONDS=600      # self-ping so a free Render instance never sleeps (0 = off)
# KEEPALIVE_URL=             # defaults to $RENDER_EXTERNAL_URL/healthz
# PORT=                      # set by Render; binds 0.0.0.0

# Agent
# PIP_CONTENT_URL=https://little-explorer-pip.onrender.com/content   # fetch the latest books each session
# PIP_SERVER_URL=https://little-explorer-pip.onrender.com   # where Milo reports per-device usage (POST /usage)
# PIP_IDLE_TIMEOUT_S=20      # Milo turns off after this many seconds with nobody talking (0 = never)

# Devices, daily limits and usage (see README "Naps and daily limits per device")
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require   # durable storage; unset = local SQLite
# PIP_DEVICES_DB=~/.config/little-explorer/devices.sqlite3          # SQLite file when DATABASE_URL is unset
# PIP_REPORT_KEY=            # shared by the agent and the token server for POST /usage (long random string)
# PIP_ADMIN_KEY=             # for /admin/* and tools/devices.py; never put it in the app
# PIP_LIMIT_UNKNOWN_MIN=10   # Milo minutes per day for a device you haven't approved (blocked when used up)
# PIP_LIMIT_APPROVED_MIN=60  # Milo minutes per day for an approved device
# PIP_LIMIT_MIN_START_S=30   # don't start a session with less time than this left
# PIP_TIMEZONE=America/Los_Angeles   # when a "day" starts
